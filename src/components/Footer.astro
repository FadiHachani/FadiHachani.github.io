---
import { profile } from "../data/content";
import { icons } from "./icons";

const year = 2026;
---

<section class="contact" id="contact">
  <div class="wrap contact-inner">
    <div class="contact-kicker reveal">$ ./say-hello.sh</div>
    <h2 class="contact-title reveal" style="--d:60ms">Let's build something solid.</h2>
    <div class="reveal" style="--d:120ms">
      <a href={`mailto:${profile.email}`} class="contact-mail">{profile.email}</a>
    </div>
    <div class="contact-links reveal" style="--d:160ms">
      <a href={profile.links.linkedin} target="_blank" rel="noreferrer" class="btn">
        <span style="display:contents" set:html={icons.linkedin} /> LinkedIn
      </a>
      <a href={profile.links.github} target="_blank" rel="noreferrer" class="btn">
        <span style="display:contents" set:html={icons.github} /> GitHub
      </a>
      <a href={`mailto:${profile.email}`} class="btn">
        <span style="display:contents" set:html={icons.mail} /> Email
      </a>
    </div>

    <div class="footer">
      <span>© {year} {profile.name}. Built from the wire up.</span>
      <span>{profile.location} · {profile.role}</span>
    </div>
  </div>
</section>
