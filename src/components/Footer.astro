---
import { profile } from "../data/content";
import { icons } from "./icons";

const year = 2026;
---

<section class="contact" id="contact">
  <div class="wrap">
    <div class="contact-eyebrow reveal">Correspondence</div>
    <h2 class="contact-title reveal" style="--d:60ms">
      Let's build something <em>solid.</em>
    </h2>
    <div class="reveal" style="--d:130ms">
      <a href={`mailto:${profile.email}`} class="contact-mail">{profile.email}</a>
    </div>
    <div class="contact-links reveal" style="--d:180ms">
      <a href={profile.links.linkedin} target="_blank" rel="noreferrer" class="btn">
        <span style="display:contents" set:html={icons.linkedin} /> LinkedIn
      </a>
      <a href={profile.links.github} target="_blank" rel="noreferrer" class="btn">
        <span style="display:contents" set:html={icons.github} /> GitHub
      </a>
      <a href={`mailto:${profile.email}`} class="btn">
        <span style="display:contents" set:html={icons.mail} /> Email
      </a>
    </div>

    <div class="colophon">
      <span>© {year} {profile.name}</span>
      <span>Set in Newsreader &amp; IBM Plex Mono</span>
      <span><span class="ac">●</span> {profile.location}</span>
    </div>
  </div>
</section>
