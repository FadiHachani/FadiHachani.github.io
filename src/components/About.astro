---
import { about } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section class="section" id="about">
  <div class="wrap">
    <SectionHead no="04" label="About" hint="The short version" />
    <div class="about-grid">
      <div>
        <p class="about-lead reveal" style="--d:60ms">
          Most engineers pick a layer and live there. I'd rather own the
          <em>whole path</em> — schema, service, socket, screen.
        </p>
        <div class="about-body reveal" style="--d:140ms">
          {about.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="facts reveal" style="--d:200ms">
        <div class="facts-caption">Particulars</div>
        {
          about.facts.map((f) => (
            <div class="fact-row">
              <span class="k">{f.k}</span>
              <span class={"v" + (f.ac ? " ac" : "")}>{f.v}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
