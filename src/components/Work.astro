---
import { projects } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section class="section" id="work">
  <div class="wrap">
    <SectionHead no="01" label="Selected Work" hint="Production systems, described by what they run on" />
    <h2 class="sec-title reveal" style="--d:80ms">Things I've <em>built.</em></h2>
    <div class="work-list">
      {
        projects.map((p, i) => (
          <article class="proj reveal" style={`--d:${i * 60}ms`}>
            <div class="proj-side">
              <span class="proj-no">{String(i + 1).padStart(2, "0")}</span>
              <span class="proj-when">{p.meta.join(" · ")}</span>
            </div>
            <div>
              <h3 class="proj-title">{p.title} <em>— {p.kicker.toLowerCase()}</em></h3>
              <p class="proj-desc">{p.desc}</p>
              <ul class="proj-points">
                {p.points.map((pt, j) => (
                  <li>
                    <span class="pi">{String(j + 1).padStart(2, "0")} /</span>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
              <div class="proj-stack">
                {p.tags.map((t) => <span class="t">{t}</span>)}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
