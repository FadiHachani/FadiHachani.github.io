---
// Theme toggle button. The actual theme is applied by an inline script
// in BaseLayout's <head> (before paint) to avoid a flash of wrong theme.
---
<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  class="grid place-items-center w-9 h-9 rounded-lg border border-app bg-elev text-muted hover:text-accent transition-colors"
>
  <!-- sun (shown in dark mode → click for light) -->
  <svg id="icon-sun" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <!-- moon (shown in light mode → click for dark) -->
  <svg id="icon-moon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById("theme-toggle");
    const sun = document.getElementById("icon-sun");
    const moon = document.getElementById("icon-moon");

    function sync() {
      const isDark =
        (document.documentElement.getAttribute("data-theme") || "dark") === "dark";
      sun.classList.toggle("hidden", !isDark);
      moon.classList.toggle("hidden", isDark);
    }

    btn.addEventListener("click", function () {
      const current =
        document.documentElement.getAttribute("data-theme") || "dark";
      const next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
      sync();
    });

    sync();
  })();
</script>
