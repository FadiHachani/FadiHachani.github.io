---
import { experience } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section class="section" id="experience">
  <div class="wrap">
    <SectionHead
      num="02"
      label="Experience"
      title="Where I've shipped"
      sub="Roles in parallel — building products and shipping backend & AI systems."
    />
    <div class="timeline">
      {
        experience.map((x, i) => (
          <div class="tl-item reveal" style={`--d:${i * 80}ms`}>
            <div class="tl-when">
              {x.when}
              {x.now && (
                <div class="now"><span class="live-dot"></span>current</div>
              )}
            </div>
            <div>
              <h3 class="tl-role">{x.role}</h3>
              <p class="tl-org">@ {x.org} <span class="place">· {x.place}</span></p>
              <p class="tl-text">{x.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
