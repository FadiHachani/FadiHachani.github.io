---
import { experience } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section class="section" id="experience">
  <div class="wrap">
    <SectionHead no="02" label="Experience" hint="Roles in parallel  backend, AI & product" />
    <h2 class="sec-title reveal" style="--d:80ms">Where I've <em>shipped.</em></h2>
    <div class="ledger">
      {
        experience.map((x, i) => (
          <div class="ledger-row reveal" style={`--d:${i * 60}ms`}>
            <span class="ledger-when">{x.when}</span>
            <div>
              <h3 class="ledger-role">{x.role} <em>@ {x.org}</em></h3>
              <p class="ledger-org">{x.place}</p>
              <p class="ledger-text">{x.text}</p>
            </div>
            {x.now && <span class="ledger-now"><i></i>Current</span>}
          </div>
        ))
      }
    </div>
  </div>
</section>
