---
import { skills } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section class="section" id="skills">
  <div class="wrap">
    <SectionHead no="03" label="Index of Skills" hint="Grouped by where it lives in the stack" />
    <h2 class="sec-title reveal" style="--d:80ms">The <em>toolbox.</em></h2>
    <div class="index-grid">
      {
        skills.map((g, i) => (
          <div class="index-col reveal" style={`--d:${(i % 4) * 60}ms`}>
            <div class="index-head">
              <span class="nm">{g.nm}</span>
              <span class="ix">{g.ix}</span>
            </div>
            <ul class="index-items">
              {g.items.map((it) => <li>{it}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
