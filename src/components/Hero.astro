---
import { icons } from "./icons";
---

<header class="hero" id="top">
  <canvas id="flowCanvas"></canvas>
  <div class="hero-fade"></div>
  <div class="wrap hero-inner">
    <div class="hero-eyebrow reveal">Software Engineer</div>
    <h1 class="hero-name">
      <span class="ln">Fadi</span>
      <span class="ln"><em>Hachani</em><span class="stop">.</span></span>
    </h1>
    <p class="hero-tag reveal" style="--d:520ms">
      I build <b>real-time backends</b> and <b>AI systems</b>  and I like to understand
      them <em>end-to-end</em>, from the architecture diagram down to the bytes on the wire.
    </p>
    <div class="hero-cta reveal" style="--d:650ms">
      <a href="#work" class="btn btn-primary">
        Selected work <span style="display:contents" set:html={icons.arrow} />
      </a>
      <a href="#contact" class="btn">Get in touch</a>
    </div>
  </div>
  <div class="wrap">
    <div class="hero-strip reveal" style="--d:800ms">
      <span class="item"><span class="dot"></span>Open to talk</span>
      <span class="item"><span class="k">Now </span> Software Engineer @ Symmetryk AG</span>
      <span class="item"><span class="k">&amp;</span> CTO @ Déligo</span>
      <span class="item"><span class="k">From</span> Marsa, Tunisia · 36.88°N 10.32°E</span>
    </div>
  </div>
</header>
